# =====================================================================
#  .gitignore - Qt 6 / CMake / Qt Creator (Windows)
# =====================================================================

# ---- Build & deploy output ------------------------------------------
/build/
/build-*/
/dist/
/out/

# ---- Qt Creator / QML tooling (per-user, absolute paths) -------------
.qtcreator/
CMakeLists.txt.user*
*.user
*.user.*
*.autosave
.qmlls.ini
CMakeUserPresets.json

# ---- CMake artefacts (neu lo build in-source) ------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
_deps/
Testing/

# ---- Qt generated files (qmake / in-source) --------------------------
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qmlc
*.jsc
*_qmlcache.qrc
.qmake.stash

# ---- Compiled binaries -----------------------------------------------
*.o
*.obj
*.a
*.lib
*.exp
*.ilk
*.pdb
*.exe
*.dll
*.so
*.so.*
*.dylib

# DLL/file ben thu 3 can kem khi deploy -> van duoc commit
!/deploy_extra/**

# ---- IDE khac ----------------------------------------------------------
.vs/
.vscode/
.idea/
.cache/

# ---- OS ----------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
$RECYCLE.BIN/
*.tmp
*~
