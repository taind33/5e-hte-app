+/* ---------------- AC/DC supply READBACK / confirmation -------------------
+ * Every string the firmware sends to the two bench supplies lives here, so
+ * a syntax difference found on the bench is a one-line change + rebuild.
+ * Terminator "\r\n" is appended by device_power.c - do NOT add it here.
+ *
+ * AC = ITECH IT-M7700 (SCPI). Set sequence (unchanged, bench-verified):
+ *   SYST:REM, PROT:MODE AC, NORM:VOLT:AC <v>, NORM:FREQ <f>, OUTP ON|OFF.
+ * Confirmation after a set / on a "refresh" request:
+ *   SYST:ERR?  -> "<code>,<text>" (or "+0"); code 0 = no error. The queue is
+ *                 drained BEFORE a set so an old error cannot fail a new one.
+ *   OUTP?      -> ON|OFF (1|0 also accepted) - must equal the requested state.
+ *   MEAS:VOLT? / MEAS:CURR? (operator-specified) and MEAS:FREQ? -> number.
+ *   The IT-M7700 programming guide also lists MEAS:VOLT:AC? / MEAS:CURR:AC?;
+ *   if the short form is rejected on the bench (SYST:ERR? then reports it
+ *   and the app shows the error code), switch the two macros below.
+ *
+ * DC = Matsusada ("#0 ..." addressed ASCII). Model/command manual not yet
+ * confirmed: readback uses the operator-specified MEAS:VOLT?/MEAS:CURR?
+ * with the same "#0 " address prefix as every other DC command. Replies
+ * are parsed by taking the LAST number in the line, so "12.34", "#0 12.34",
+ * "+1.234E+01" and "12.34V" all work. DC_CMD_QUERY_OUTPUT is left empty
+ * (no output-state query known) -> DC is "confirmed" when it answers the
+ * readback queries right after a set; fill it in (e.g. a status command
+ * answering ON/OFF or 1/0) once the manual is available. */
+#define AC_CMD_REMOTE           "SYST:REM"
+#define AC_CMD_MODE             "PROT:MODE AC"
+#define AC_CMD_QUERY_ERROR      "SYST:ERR?"
+#define AC_CMD_QUERY_OUTPUT     "OUTP?"
+#define AC_CMD_MEAS_VOLT        "MEAS:VOLT?"
+#define AC_CMD_MEAS_CURR        "MEAS:CURR?"
+#define AC_CMD_MEAS_FREQ        "MEAS:FREQ?"
+
+#define DC_CMD_REMOTE           "#0 REN"
+#define DC_CMD_MEAS_VOLT        "#0 MEAS:VOLT?"
+#define DC_CMD_MEAS_CURR        "#0 MEAS:CURR?"
+#define DC_CMD_QUERY_OUTPUT     ""          /* "" = not available */
+
+/* Timing. Per-query reply timeout; the first query that times out ends the
+ * transaction (result "no reply") instead of waiting out every remaining
+ * one. IT-M7700 rule: the complete reply must be received before the next
+ * command is sent - the firmware never has more than one query in flight
+ * per supply. */
+#define PWR_REPLY_TIMEOUT_MS    500U
+#define PWR_INTER_CMD_GAP_MS    20U     /* after a reply, before next command */
+#define PWR_WRITE_GAP_MS        50U     /* after a write-only command (same
+                                         * pacing as the verified sequence)  */
+#define PWR_ERR_DRAIN_MAX       20U     /* IT-M7700 error queue depth (20)   */
+
